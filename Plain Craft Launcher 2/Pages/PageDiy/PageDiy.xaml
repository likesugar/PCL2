<local:MyPageRight x:Class="PageDiy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL"
             PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer x:Name="PanBack" Margin="15,0,0,0">
        <StackPanel Margin="0,0,15,15">
            <local:MyCard Margin="0,0,0,15" Title="樱花飘落动画">
                <StackPanel Margin="25,38,23,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="启用飘落动画" VerticalAlignment="Center" FontSize="13" />
                        <local:MyCheckBox Grid.Column="1" x:Name="CheckDiySakura" Text="" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="花瓣数量" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" x:Name="SliderDiySakuraCount" Minimum="5" Maximum="35" Value="15" Margin="20,0,20,0" TickFrequency="1" IsSnapToTickEnabled="True" />
                        <TextBlock Grid.Column="2" x:Name="LabDiySakuraCount" Text="15" VerticalAlignment="Center" FontSize="13" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="失焦时暂停" VerticalAlignment="Center" FontSize="13" />
                        <local:MyCheckBox Grid.Column="2" x:Name="CheckDiySakuraPause" Text="" />
                    </Grid>
                    <TextBlock Text="花瓣样式" FontSize="13" Margin="0,10,0,5" />
                    <WrapPanel>
                        <local:MyButton x:Name="BtnDiyStyleSakura" Text="樱花" MinWidth="80" Height="28" Margin="0,0,10,0" />
                        <local:MyButton x:Name="BtnDiyStyleLeaf" Text="落叶" MinWidth="80" Height="28" Margin="0,0,10,0" />
                        <local:MyButton x:Name="BtnDiyStyleSnow" Text="雪花" MinWidth="80" Height="28" Margin="0,0,10,0" />
                        <local:MyButton x:Name="BtnDiyStyleStar" Text="星光" MinWidth="80" Height="28" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="主题色">
                <StackPanel Margin="25,38,23,15">
                    <WrapPanel>
                        <local:MyButton x:Name="BtnDiyThemePink" Text="樱花粉" MinWidth="90" Height="28" Margin="0,0,10,5" />
                        <local:MyButton x:Name="BtnDiyThemeBlue" Text="天空蓝" MinWidth="90" Height="28" Margin="0,0,10,5" />
                        <local:MyButton x:Name="BtnDiyThemePurple" Text="梦幻紫" MinWidth="90" Height="28" Margin="0,0,10,5" />
                        <local:MyButton x:Name="BtnDiyThemeGreen" Text="清新绿" MinWidth="90" Height="28" Margin="0,0,10,5" />
                        <local:MyButton x:Name="BtnDiyThemeOrange" Text="暖阳橙" MinWidth="90" Height="28" Margin="0,0,0,5" />
                    </WrapPanel>
                    <TextBlock Text="主题色将切换到 PCL 内置主题中最接近的颜色" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="界面调整">
                <StackPanel Margin="25,38,23,15">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" /><ColumnDefinition /><ColumnDefinition Width="45" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="背景模糊" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" x:Name="SliderDiyBlur" Minimum="0" Maximum="50" Value="8" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2" x:Name="LabDiyBlur" Text="8" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" /><ColumnDefinition /><ColumnDefinition Width="45" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="窗口圆角" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" x:Name="SliderDiyRadius" Minimum="0" Maximum="30" Value="14" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2" x:Name="LabDiyRadius" Text="14" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13" />
                    </Grid>
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" /><ColumnDefinition /><ColumnDefinition Width="45" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="窗口透明度" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" x:Name="SliderDiyOpacity" Minimum="40" Maximum="100" Value="100" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2" x:Name="LabDiyOpacity" Text="100" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
                    </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
