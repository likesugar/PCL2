<local:MyPageRight x:Class="PageAIRight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <Grid Margin="12,12,12,6" MinWidth="640">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="300" />
                <ColumnDefinition Width="1.2*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- 左：设置卡 -->
            <local:MyCard Grid.Column="0" Margin="0,0,4,0">
                <StackPanel Margin="14,10,14,12">
                    <Grid>
                        <TextBlock Text="AI 助手" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" />
                        <CheckBox x:Name="ChkEnabled" Content="启用" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="接口地址" FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,8,0,2" />
                    <ComboBox x:Name="ComboBase" IsEditable="True" Height="26" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="模型" FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,2" />
                            <ComboBox x:Name="ComboModel" IsEditable="True" Height="26" />
                        </StackPanel>
                        <local:MyButton x:Name="BtnGetModels" Grid.Column="1" Text="获取模型" Width="80" Height="26" Margin="6,16,0,0" ColorType="Highlight" />
                    </Grid>
                    <TextBlock Text="API Key" FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,6,0,2" />
                    <TextBox x:Name="TextKey" Height="26" />
                    <TextBlock Text="安全策略" FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,6,0,2" />
                    <ComboBox x:Name="ComboSafety" Height="26">
                        <ComboBoxItem Content="谨慎：每次操作前询问" IsSelected="True" />
                        <ComboBoxItem Content="宽松：所有操作自动执行" />
                    </ComboBox>
                    <CheckBox x:Name="ChkMascot" Content="显示看板娘（右下角小人）" Margin="0,8,0,0" Height="22" />
                    <CheckBox x:Name="ChkNetAccess" Content="允许访问本机与内网地址" Margin="0,4,0,0" Height="22" />
                    <local:MyButton x:Name="BtnSaveConfig" Text="保存设置" Width="110" Height="28" Margin="0,10,0,0" HorizontalAlignment="Left" ColorType="Highlight" />
                </StackPanel>
            </local:MyCard>

            <!-- 右：对话卡（输入行钉底） -->
            <local:MyCard Grid.Column="1" Margin="4,0,0,0">
                <Grid MinHeight="300">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,10,14,0">
                        <TextBlock Text="对话" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" />
                        <local:MyButton x:Name="BtnClearChat" Text="清空" Width="64" Height="24" HorizontalAlignment="Right" />
                    </Grid>
                    <local:MyScrollViewer x:Name="PanChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,8,10,0">
                        <StackPanel x:Name="PanChatList" MinHeight="80" Width="Auto" />
                    </local:MyScrollViewer>
                    <Grid Grid.Row="2" Margin="10,8,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TextInput" Height="34" TextWrapping="Wrap" AcceptsReturn="False" VerticalContentAlignment="Center" />
                        <local:MyButton x:Name="BtnSend" Grid.Column="1" Text="发送" Width="64" Height="34" Margin="6,0,0,0" ColorType="Highlight" />
                    </Grid>
                </Grid>
            </local:MyCard>
        </Grid>
    </local:MyScrollViewer>
</local:MyPageRight>
