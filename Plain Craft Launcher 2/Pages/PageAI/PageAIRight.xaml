<local:MyPageRight x:Class="PageAIRight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <Grid Margin="12,12,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <!-- 左：设置卡 -->
            <local:MyCard Grid.Column="1" Margin="4,0,0,0">
                <Grid Margin="10,8,10,9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="AI 助手" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" />
                    <CheckBox x:Name="ChkEnabled" Content="启用" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Grid.Row="1" Text="接口地址" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,6,0,1" />
                <ComboBox Grid.Row="2" x:Name="ComboBase" IsEditable="True" Height="24" />
                <Grid Grid.Row="3" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="模型" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,1" />
                        <ComboBox x:Name="ComboModel" IsEditable="True" Height="24" />
                    </StackPanel>
                    <local:MyButton x:Name="BtnGetModels" Grid.Column="1" Text="获取模型" Width="72" Height="24" Margin="4,14,0,0" ColorType="Highlight" />
                </Grid>
                <TextBlock Grid.Row="4" Text="API Key" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,5,0,1" />
                <TextBox Grid.Row="5" x:Name="TextKey" Height="24" />
                <TextBlock Grid.Row="6" Text="安全策略" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,5,0,1" />
                <ComboBox Grid.Row="7" x:Name="ComboSafety" Height="24">
                    <ComboBoxItem Content="谨慎：每次操作前询问" IsSelected="True" />
                    <ComboBoxItem Content="宽松：所有操作自动执行" />
                </ComboBox>
                <CheckBox Grid.Row="8" x:Name="ChkMascot" Content="显示看板娘" Margin="0,6,0,0" Height="20" />
                <CheckBox Grid.Row="9" x:Name="ChkNetAccess" Content="允许访问本机与内网地址" Margin="0,3,0,0" Height="20" />
                <local:MyButton Grid.Row="10" x:Name="BtnSaveConfig" Text="保存设置" Width="96" Height="26" Margin="0,8,0,0" HorizontalAlignment="Left" ColorType="Highlight" />
            </Grid>
            </local:MyCard>

            <!-- 右：对话卡（输入行钉底） -->
            <local:MyCard Grid.Column="0" Margin="0,0,4,0">
                <Grid MinHeight="300">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,10,14,0">
                        <TextBlock Text="对话" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ColorBrush1}" VerticalAlignment="Center" />
                        <local:MyButton x:Name="BtnClearChat" Text="清空" Width="56" Height="22" HorizontalAlignment="Right" />
                    </Grid>
                    <local:MyScrollViewer x:Name="PanChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,8,10,0">
                        <StackPanel x:Name="PanChatList" MinHeight="80" />
                    </local:MyScrollViewer>
                    <Grid Grid.Row="2" Margin="10,8,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TextInput" Height="30" TextWrapping="Wrap" AcceptsReturn="False" VerticalContentAlignment="Center" />
                        <local:MyButton x:Name="BtnSend" Grid.Column="1" Text="发送" Width="56" Height="30" Margin="6,0,0,0" ColorType="Highlight" />
                    </Grid>
                </Grid>
            </local:MyCard>
        </Grid>
    </local:MyScrollViewer>
</local:MyPageRight>
